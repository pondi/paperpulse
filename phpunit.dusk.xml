<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_URL" value="http://127.0.0.1:8082" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_HOST" value="postgres" force="true"/>
        <env name="DB_PORT" value="5432" force="true"/>
        <env name="DB_DATABASE" value="paperpulse_browser_test" force="true"/>
        <env name="DB_USERNAME" value="paperpulse_test" force="true"/>
        <env name="DB_PASSWORD" value="paperpulse_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="isolated-test" force="true"/>
        <env name="OPENAI_API_KEY" value="isolated-test" force="true"/>
        <env name="TEXTRACT_KEY" value="isolated-test" force="true"/>
        <env name="TEXTRACT_SECRET" value="isolated-test" force="true"/>
        <env name="SCOUT_DRIVER" value="collection" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="database" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="BROADCAST_CONNECTION" value="log" force="true"/>
    </php>
</phpunit>
